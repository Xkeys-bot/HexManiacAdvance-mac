<!--
   Ported from HexManiac.WPF/Controls/TutorialControl.xaml.

   The Canvas.Style DataTrigger that hid the whole control at 100% completion becomes a bound
   IsVisible; the ItemContainerStyle that positioned each card via Canvas.Top becomes a
   container-level style, with the actual movement driven from code-behind (AnimationExtensions).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HavenSoft.HexManiac.AvaloniaUI.Controls.TutorialControl"
             xmlns:res="clr-namespace:HavenSoft.HexManiac.AvaloniaUI.Resources">
   <Canvas ClipToBounds="False" Width="100" Height="450" Name="ContentPanel" HorizontalAlignment="Left"
           IsVisible="{Binding CompletionPercent, Converter={x:Static res:NotEqualConverter.Instance}, ConverterParameter=100.00%}">
      <Canvas.Resources>
         <res:IconConverter x:Key="IconConverter" />
      </Canvas.Resources>
      <ItemsControl Name="Tutorials" ItemsSource="{Binding Tutorials}" Width="400" Height="450" Canvas.Left="0">
         <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><Canvas ClipToBounds="True" /></ItemsPanelTemplate>
         </ItemsControl.ItemsPanel>
         <!--
            WPF set Canvas.Top and Visibility through an ItemContainerStyle. They have to stay on
            the container: a Canvas positions the generated ContentPresenter, so the same
            attached properties written inside the ItemTemplate would leave every card at y=0.
         -->
         <ItemsControl.Styles>
            <Style Selector="ItemsControl#Tutorials > ContentPresenter">
               <Setter Property="Canvas.Top" Value="{Binding TopEdge}" />
               <Setter Property="Canvas.Left" Value="0" />
               <Setter Property="IsVisible" Value="{Binding Incomplete}" />
            </Style>
         </ItemsControl.Styles>
         <ItemsControl.ItemTemplate>
            <!-- Each card is 400x90, with 100x90 on the left for the icon/title and 300x90 for the description. -->
            <DataTemplate>
               <Border BorderThickness="1" BorderBrush="{DynamicResource Secondary}" Background="{DynamicResource Backlight}">
                  <Canvas Width="398" Height="88">
                     <Decorator Width="98" Height="78">
                        <Path Data="{Binding Icon, Converter={StaticResource IconConverter}}" Stretch="Uniform" Margin="5,20,5,5" Fill="{DynamicResource Secondary}" />
                     </Decorator>
                     <TextBlock FontWeight="Bold" Width="98" TextAlignment="Center" Text="{Binding Title}" Canvas.Top="2" />
                     <TextBlock FontStyle="Italic" Width="98" TextAlignment="Center" Text="{Binding IndexText}" Canvas.Bottom="2" />
                     <Decorator Width="300" Height="88" Canvas.Left="98">
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10" Text="{Binding Content}" />
                     </Decorator>
                     <Button Command="{res:MethodCommand Close}" Width="20" Height="20" Canvas.Top="1" Canvas.Right="1">
                        <Path Fill="{DynamicResource Secondary}" Data="{res:Icon Exit}" Stretch="Uniform" />
                     </Button>
                  </Canvas>
               </Border>
            </DataTemplate>
         </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Path Name="Check" Data="{res:Icon Check}" Fill="{DynamicResource Stream2}" Stretch="Uniform" Width="60" Height="60" Opacity="0" Canvas.Top="0" Canvas.Right="0" IsHitTestVisible="False" />
      <Border Canvas.Top="-20" Canvas.Right="0" Height="20" Width="110" Background="{DynamicResource Backlight}" BorderBrush="{DynamicResource Secondary}"
              BorderThickness="1" IsVisible="{Binding #ContentPanel.IsPointerOver}">
         <Border.ContextMenu>
            <ContextMenu>
               <MenuItem Header="Dismiss All" Command="{res:MethodCommand DismissAll}" />
               <MenuItem Header="Restart All" Command="{res:MethodCommand Reset}" />
            </ContextMenu>
         </Border.ContextMenu>
         <TextBlock HorizontalAlignment="Center">
            <Run Text="Tutorials (" /><Run Text="{Binding CompletionPercent, Mode=OneWay}" /><Run Text=")" />
         </TextBlock>
      </Border>
      <Border Canvas.Bottom="0" Canvas.Right="0" Height="20" Width="110" IsVisible="{Binding SeeMore}">
         <Border Background="{DynamicResource Backlight}" BorderBrush="{DynamicResource Secondary}"
                 BorderThickness="1" IsVisible="{Binding #ContentPanel.IsPointerOver}">
            <ToolTip.Tip>
               <TextBlock>
                  Complete actions to clear tutorials.<LineBreak />
                  Additional tutorials will show until you've completed them all.
               </TextBlock>
            </ToolTip.Tip>
            <TextBlock HorizontalAlignment="Center" Text="See More..."/>
         </Border>
      </Border>
   </Canvas>
</UserControl>
